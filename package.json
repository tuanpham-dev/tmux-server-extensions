{
  "name": "tmux-server-extensions",
  "private": true,
  "version": "1.0.0",
  "description": "Optional tmux-server extensions, packaged as installable .tsix files.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "pack": "npm run build && node scripts/pack.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && node scripts/check.mjs",
    "test": "node --experimental-strip-types --test */src/*.test.ts"
  },
  "devDependencies": {
    "@shikijs/core": "^4.4.3",
    "@shikijs/engine-javascript": "^4.4.3",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/vscode-textmate": "^10.0.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.23.0",
    "ghostty-web": "0.4.0",
    "monaco-editor": "^0.56.0",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.23.1": true
  }
}
