{
  "name": "tmux-server-extensions",
  "private": true,
  "version": "1.0.0",
  "description": "Optional tmux-server extensions, packaged as installable .tsix files.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "pack": "npm run build && node scripts/pack.mjs",
