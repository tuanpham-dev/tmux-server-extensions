// Dark Modern — flattened from VS Code's dark_plus.json → dark_vs.json, plus dark_modern.json include
// chain (microsoft/vscode, MIT license — see LICENSE.txt), since this app's
// theme loader follows only one `include` level and `*_plus.json` files
// contribute no workbench colors anyway (tokenColors only, which this app
// ignores). Colors extracted from the local code-server install
// (/usr/lib/code-server/lib/vscode/extensions/theme-defaults/themes/).
//
// The following keys are NOT present in any of VS Code's theme JSON files —
// they are registered with hardcoded defaults in VS Code's own source
// (registerColor calls in workbench.web.main.internal.js) rather than theme
// JSON, so they were extracted from that source and injected here:
// terminal.ansi* (all 16), gitDecoration.modifiedResourceForeground,
// gitDecoration.addedResourceForeground, gitDecoration.renamedResourceForeground,
// gitDecoration.untrackedResourceForeground, editor.selectionBackground,
// charts.yellow, charts.green, editorWarning.foreground. Also added for a
// fully self-contained terminal palette (no fallback into another theme's
// terminal colors): terminal.background, terminalCursor.foreground,
// terminalCursor.background, terminal.selectionBackground.
{
  "$schema": "vscode://schemas/color-theme",
  "name": "Dark Modern",
  "colors": {
    "actionBar.toggledBackground": "#383a49",
    "activityBar.activeBorder": "#0078D4",
    "activityBar.background": "#181818",
    "activityBar.border": "#2B2B2B",
    "activityBar.foreground": "#D7D7D7",
    "activityBar.inactiveForeground": "#868686",
    "activityBarBadge.background": "#0078D4",
    "activityBarBadge.foreground": "#FFFFFF",
    "agentsChatInput.border": "#303031",
